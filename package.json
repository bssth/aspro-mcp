{
  "name": "aspro-mcp",
  "version": "0.2.1",
  "description": "MCP server for the Aspro.Cloud REST API",
  "type": "module",
  "license": "MIT",
  "author": "Borys Stelmakh <bs@cringe.ltd>",
  "homepage": "https://github.com/bssth/aspro-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bssth/aspro-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/bssth/aspro-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "aspro",
    "aspro-cloud",
    "claude",
    "llm",
    "openapi"
  ],
  "bin": {
    "aspro-mcp": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/THIRD_PARTY_LICENSES.txt",
    "spec",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && node build.mjs",
    "start": "node dist/index.js",
    "dev": "node build.mjs --watch",
    "smoke": "node dist/smoke.js",
    "e2e": "node dist/e2e.js",
    "test": "npm run smoke && npm run e2e",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "zod": "^3.23.8"
  }
}
